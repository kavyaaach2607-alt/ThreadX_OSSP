#include <fcntl.h>
#include <unistd.h>

int main() {
    int s = open("source.txt", O_RDONLY);
    int d = open("destination.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
    char b[100];
    int n;

    while ((n = read(s, b, 100)) > 0)
        write(d, b, n);

    close(s);
    close(d);
    return 0;
}
