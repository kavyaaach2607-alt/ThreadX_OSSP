#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>
int main()
{
char msg[50];
int fd;
mkfifo("fifo", 0666);
int pid = fork();
if (pid == 0)
{
fd = open("fifo", O_WRONLY);
printf("Enter message: ");
scanf("%s", msg);
write(fd, msg, 50);
close(fd);
}
else
{
fd = open("fifo", O_RDONLY);
read(fd, msg, 50);
printf("Server received: %s\n", msg);
close(fd);
}
return 0;
}
