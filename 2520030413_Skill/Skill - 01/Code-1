#include<stdio.h>
#include<unistd.h>
#include <sys/types.h>
int main() {
pid_t pid;
pid = fork();
if(pid == 0) {
printf("Child Proces\n");
printf("Child PID = %d\n", getpid());
}
else if(pid > 0) {
printf("Parent Proces\n");
printf("Parent PID = %d\n", getpid());
}
else {
printf("Fork Failed!\n");
}
return 0;
}
